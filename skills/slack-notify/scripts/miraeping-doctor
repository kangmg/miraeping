#!/usr/bin/env bash
# Bash-first, read-only diagnostics. Python and jq are NOT required.
set +x
set -uo pipefail
umask 077

usage() {
    printf '%s\n' 'Usage: miraeping-doctor [-h|--help]' '' \
        'Automatically check Bash/helper/curl, credentials, Slack authentication,' \
        'SGE tools, GPU prerequisites, and optional Python/miraeping.' \
        'Python is optional: active venv/conda, project .venv (uv), then PATH.' \
        'No Python means only the Python check is skipped. No jq is required.' \
        'A configured bot token triggers curl auth.test automatically (10s limit).' \
        'No credentials are printed, no helper is sourced, and no DM is sent.' \
        'No mode or online switches. Activate the job environment first.' \
        'Exit: 0 = no failures and a ready path; 1 = setup failure; 2 = bad arguments.'
}
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
(( $# == 0 )) || { printf 'Unknown argument. Use --help.\n' >&2; exit 2; }
(( BASH_VERSINFO[0] >= 4 )) || { printf '[FAIL] Bash 4+ is required.\n'; exit 1; }
[[ -n "${HOME:-}" ]] || { printf '[FAIL] HOME is not set.\n'; exit 1; }
failures=0
warnings=0
bash_ready=0
python_ready=0
gpu_ready=0
declare -A auth_cache
info() { printf '[INFO] %s\n' "$*"; }
ok() { printf '[OK] %s\n' "$*"; }
fail() { printf '[FAIL] %s\n' "$*"; failures=$((failures + 1)); }
warn() { printf '[WARN] %s\n' "$*"; warnings=$((warnings + 1)); }
has() { command -v "$1" >/dev/null 2>&1; }
trim() {
    local text="$1"
    text="${text#"${text%%[![:space:]]*}"}"
    text="${text%"${text##*[![:space:]]}"}"
    printf '%s' "$text"
}

authenticate() {
    local token="$1" headers response line scopes='' scope scopes_seen=0 before="$failures"
    if [[ -n "${auth_cache[$token]+x}" ]]; then
        info 'Reusing authentication result for the same token.'
        return "${auth_cache[$token]}"
    fi
    auth_cache[$token]=1
    has curl || { fail 'Slack authentication requires curl.'; return 1; }
    headers="$(mktemp)" || { fail 'Cannot create temporary response-header file.'; return 1; }
    # Never pass tokens as argv, write them to disk, or print curl diagnostics.
    if ! response="$(curl --disable --silent --show-error --fail --connect-timeout 5 --max-time 10 \
        --config - --dump-header "$headers" --request POST --data '' \
        https://slack.com/api/auth.test 2>/dev/null \
        <<< "header = \"Authorization: Bearer $token\"")"; then
        fail 'Slack auth.test failed (network, HTTP, or timeout).'
    # Deliberately narrow recognition of Slack's leading top-level ok field.
    # Do not search arbitrary nested objects/strings for an ok:true substring.
    elif [[ "$response" =~ ^[[:space:]]*\{[[:space:]]*\"ok\"[[:space:]]*:[[:space:]]*true[[:space:]]*[,}] ]]; then
        ok 'Slack auth.test succeeded; token is accepted.'
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "${line,,}" == http/* ]]; then
                scopes=''; scopes_seen=0
            elif [[ "${line,,}" == x-oauth-scopes:* ]]; then
                scopes="${line#*:}"; scopes="${scopes//[[:space:]]/}"; scopes_seen=1
            fi
        done < "$headers"
        if (( ! scopes_seen )); then
            warn 'Slack did not report scopes; DM permissions are unverified.'
        else
            for scope in im:write chat:write; do
                case ",$scopes," in
                    *,"$scope",*) ok "DM scope present: $scope" ;;
                    *) fail "Missing DM scope: $scope; ask the existing bot administrator." ;;
                esac
            done
        fi
    else
        fail 'Slack auth.test did not confirm authentication (rejected token or unrecognized response).'
    fi
    rm -f -- "$headers"
    if (( failures == before )); then auth_cache[$token]=0; return 0; fi
    return 1
}

check_credentials() {
    local workflow="$1" file="$HOME/.miraeping/credentials" key value permissions ready=1
    local token="${SLACK_BOT_TOKEN:-}" user_id="${SLACK_USER_ID:-}"
    local token_set="${SLACK_BOT_TOKEN+x}" user_set="${SLACK_USER_ID+x}"
    local token_source=environment user_source=environment
    if [[ "$workflow" != gpu && -e "$file" ]]; then
        if [[ ! -r "$file" ]]; then
            warn 'Credentials file is not readable; checking environment fallback.'
        else
            permissions="$(stat -c %a "$file" 2>/dev/null || true)"
            if [[ "$permissions" =~ ^[0-7]{3,4}$ ]] && (( (8#$permissions & 077) != 0 )); then
                warn 'Credentials file is accessible to others; use chmod 600 on ~/.miraeping/credentials.'
            fi
            while IFS='=' read -r key value || [[ -n "$key" ]]; do
                key="${key%$'\r'}"; value="${value%$'\r'}"
                if [[ "$workflow" == python ]]; then key="$(trim "$key")"; value="$(trim "$value")"; fi
                [[ -n "$value" ]] || continue
                case "$key" in
                    SLACK_BOT_TOKEN)
                        if [[ "$workflow" == bash || -z "$token_set" ]]; then
                            token="$value"; token_set=x; token_source='credentials file'
                        fi ;;
                    SLACK_USER_ID)
                        if [[ "$workflow" == bash || -z "$user_set" ]]; then
                            user_id="$value"; user_set=x; user_source='credentials file'
                        fi ;;
                esac
            done < "$file"
        fi
    fi
    if [[ "$token" =~ ^xoxb-[A-Za-z0-9-]+$ ]]; then
        ok "SLACK_BOT_TOKEN [$workflow]; source: $token_source"
    else
        fail "SLACK_BOT_TOKEN missing or malformed [$workflow]; source: $token_source"; ready=0
    fi
    if [[ "$user_id" =~ ^[UW][A-Z0-9]{8,}$ ]]; then
        ok "SLACK_USER_ID [$workflow]; source: $user_source"
    else
        fail "SLACK_USER_ID missing or malformed [$workflow]; source: $user_source"; ready=0
    fi
    if [[ "$token" =~ ^xoxb-[A-Za-z0-9-]+$ ]]; then authenticate "$token" || ready=0; fi
    (( ready ))
}

check_bash() {
    local helper="$HOME/.miraeping/miraeping" name ready=1
    ok "Bash runtime: $BASH_VERSION"
    if has curl; then ok 'curl found'; else fail 'Bash notifications require curl.'; ready=0; fi
    check_credentials bash || ready=0
    if [[ ! -r "$helper" ]]; then
        warn 'Bash helper not installed (~/.miraeping/miraeping).'; ready=0
    elif ! "$BASH" -n "$helper" 2>/dev/null; then
        fail 'Bash helper syntax check failed.'; ready=0
    else
        for name in miraeping_send miraeping_monitor miraeping_stop; do
            if ! grep -Eq "^[[:space:]]*$name[[:space:]]*\(\)" "$helper"; then
                fail "Bash helper is missing the expected $name definition."; ready=0
            fi
        done
        info 'Source the helper in each job script; doctor does not source it.'
    fi
    bash_ready=$ready
}

# Set python_bin without launching any interpreter.
environment_python() {
    local root="$1" relative
    for relative in bin/python3 bin/python Scripts/python.exe python.exe; do
        if [[ -x "$root/$relative" && -f "$root/$relative" ]]; then python_bin="$root/$relative"; return 0; fi
    done
    return 1
}
select_python() {
    local variable root directory
    python_bin=''
    for variable in VIRTUAL_ENV CONDA_PREFIX; do
        root="${!variable:-}"
        if [[ -n "$root" ]]; then
            info "Python environment: $variable"
            environment_python "$root" || warn 'Activated environment has no Python executable; optional Python check skipped.'
            return
        fi
    done
    directory="$PWD"
    while :; do
        if [[ -d "$directory/.venv" ]]; then
            info 'Python environment: project .venv (uv/venv)'
            environment_python "$directory/.venv" || warn 'Project .venv has no Python executable; optional Python check skipped.'
            return
        fi
        [[ -e "$directory/pyproject.toml" || -e "$directory/.git" || "$directory" == / ]] && break
        directory="${directory%/*}"; [[ -n "$directory" ]] || directory=/
    done
    python_bin="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
}
check_python() {
    local python_bin='' probe
    select_python
    [[ -n "$python_bin" ]] || { info 'Python not available; optional Python check skipped.'; return; }
    info "Python executable: $python_bin"
    has timeout || { warn 'No timeout command; optional Python import check skipped to avoid hanging.'; return; }
    if ! probe="$(timeout --kill-after=1 10 "$python_bin" - 2>/dev/null <<'PY'
import sys
if sys.version_info < (3, 7):
    sys.exit(1)
import contextlib, io
try:
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
        import miraeping
        if not all(callable(getattr(miraeping, name, None)) for name in ('send', 'Job', 'Monitor')):
            raise ImportError()
    print('MIRAEPING_API_OK')
except Exception:
    sys.exit(1)
PY
    )" || [[ "$probe" != MIRAEPING_API_OK ]]; then
        warn 'Optional Python API unavailable: requires Python 3.7+ and miraeping (python -m pip install miraeping, or uv pip install --python PATH miraeping).'
        return
    fi
    # Do not echo arbitrary module output: it could contain credential values.
    ok 'miraeping notification API is importable in the selected Python.'
    info 'Package: miraeping; maintained user API has no third-party runtime dependencies.'
    check_credentials python && python_ready=1
}

check_gpu() {
    local command ready=1 output uuid index used total count=0 invalid=0
    has nvidia-smi || { info 'No nvidia-smi; GPU checks skipped. Verify on the GPU node when needed.'; return; }
    has gpu-watch || { warn 'GPU host detected, but gpu-watch is not installed.'; return; }
    for command in bash curl nohup timeout flock; do
        if ! has "$command"; then fail "gpu-watch requires $command"; ready=0; fi
    done
    [[ -d /proc/self ]] || { fail 'gpu-watch requires Linux /proc.'; ready=0; }
    check_credentials gpu || ready=0
    (( ready )) || return
    if ! output="$(timeout --kill-after=1 10 nvidia-smi --query-gpu=uuid,index,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null)"; then
        fail 'GPU query failed; check the GPU node/driver.'; return
    fi
    while IFS=, read -r uuid index used total; do
        [[ -n "$uuid" ]] || continue
        uuid="${uuid//[[:space:]]/}"; index="${index//[[:space:]]/}"
        used="${used//[[:space:]]/}"; total="${total//[[:space:]]/}"
        if [[ "$uuid" =~ ^GPU-[A-Za-z0-9-]+$ && "$index" =~ ^[0-9]+$ && "$used" =~ ^[0-9]{1,9}$ && "$total" =~ ^[0-9]{1,9}$ ]] && (( 10#$total > 0 )); then
            count=$((count + 1))
        else invalid=$((invalid + 1)); fi
    done <<< "$output"
    if (( count > 0 && invalid == 0 )); then ok "Readable GPU VRAM data: $count GPU(s)"; gpu_ready=1
    else fail 'GPU VRAM data is missing or unsupported.'; fi
}

info 'miraeping doctor: Bash-first; Python is optional.'
check_bash
check_python
check_gpu
for command in qsub qstat; do
    if has "$command"; then ok "$command found"
    else info "$command not found here; verify on SGE before submission."; fi
done
for workflow in bash python gpu; do
    case "$workflow" in bash) ready=$bash_ready ;; python) ready=$python_ready ;; gpu) ready=$gpu_ready ;; esac
    if (( ready )); then info "$workflow: ready"; else info "$workflow: unavailable or needs setup"; fi
done
(( bash_ready || python_ready || gpu_ready )) || fail 'No notification path is ready.'
info 'Recipient membership and actual DM delivery remain unverified; no message was sent.'
printf 'Result: %s failure(s), %s warning(s).\n' "$failures" "$warnings"
(( failures == 0 ))
